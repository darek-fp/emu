---
interface NavItem {
  label: string;
  href: string;
  icon: string;
}

const navItems: NavItem[] = [
  { label: "Structure Management", href: "/admin/structure", icon: "🏗️" },
  { label: "Pricing Configuration", href: "/admin/pricing", icon: "💰" },
  { label: "Operator Management", href: "/admin/operators", icon: "👥" },
];

interface Props {
  currentPath?: string;
}

const { currentPath } = Astro.props;
---

<aside class="w-64 border-r border-white/10 bg-white/5 backdrop-blur-xl">
  <div class="p-6">
    <h3 class="text-xs font-semibold tracking-wide text-gray-400 uppercase">Admin Menu</h3>
    <nav class="mt-8 space-y-2">
      {
        navItems.map((item) => {
          const isActive = currentPath === item.href || currentPath?.startsWith(item.href);
          return (
            <a
              href={item.href}
              class={`flex items-center gap-3 rounded-lg px-4 py-3 text-sm transition-colors ${
                isActive
                  ? "bg-blue-600/20 font-medium text-blue-300"
                  : "text-gray-300 hover:bg-white/5 hover:text-white"
              }`}
            >
              <span class="text-lg">{item.icon}</span>
              <span>{item.label}</span>
            </a>
          );
        })
      }
    </nav>
  </div>
</aside>
