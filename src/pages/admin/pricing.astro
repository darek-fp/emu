---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { PricingTierForm } from "@/components/admin/PricingTierForm";
import { createClient } from "@/lib/supabase";
import type { Database } from "@/database.types";

type PricingTier = Database["public"]["Tables"]["pricing_tiers"]["Row"];
type Sector = Database["public"]["Tables"]["sectors"]["Row"];

// Check authentication
const user = Astro.locals.user;
const role = Astro.locals.role;

if (!user || role !== "admin") {
  return Astro.redirect("/auth/signin");
}

// Fetch sectors and pricing tiers
const supabase = createClient(Astro.request.headers, Astro.cookies);

let sectors: Sector[] = [];
let pricingTiers: PricingTier[] = [];
let error = "";

if (supabase) {
  const { data: sectorsData, error: sectorsError } = await supabase
    .from("sectors")
    .select("*")
    .order("created_at", { ascending: true });

  if (sectorsError) {
    error = `Failed to load sectors: ${sectorsError.message}`;
  } else {
    sectors = sectorsData ?? [];
  }

  const { data: tiersData, error: tiersError } = await supabase
    .from("pricing_tiers")
    .select("*")
    .order("created_at", { ascending: false });

  if (tiersError) {
    error = `Failed to load pricing tiers: ${tiersError.message}`;
  } else {
    pricingTiers = tiersData ?? [];
  }
}

// Group tiers by sector
const tiersBySetor = new Map<string, PricingTier[]>();
for (const tier of pricingTiers) {
  if (tier.sector_id) {
    if (!tiersBySetor.has(tier.sector_id)) {
      tiersBySetor.set(tier.sector_id, []);
    }
    tiersBySetor.get(tier.sector_id)!.push(tier);
  }
}

// Get active tier for each sector
const activeTiersBySetor = new Map<string, PricingTier>();
for (const [sectorId, tiers] of tiersBySetor) {
  const activeTier = tiers.find((t) => t.ended_at === null);
  if (activeTier) {
    activeTiersBySetor.set(sectorId, activeTier);
  }
}

// Map sector IDs to names
const sectorMap = new Map(sectors.map((s) => [s.id, s.name]));
---

<AdminLayout title="Pricing Configuration">
  <style>
    /* Dark theme select styling for expanded dropdown */
    select option {
      background: #1f2937 !important;
      color: white !important;
    }
    select option:checked {
      background: linear-gradient(#3b82f6, #3b82f6) !important;
      background-color: #3b82f6 !important;
      color: white !important;
    }
    
    /* Firefox specific */
    select option:hover {
      background: #374151 !important;
      color: white !important;
    }
  </style>
  <div class="space-y-8">
    {
      error && (
        <div class="rounded-lg border border-red-500/20 bg-red-500/10 p-4">
          <p class="text-red-400">{error}</p>
        </div>
      )
    }

    <div>
      <h1 class="mb-2 text-3xl font-bold text-white">Pricing Configuration</h1>
      <p class="text-white/70">Manage pricing tiers per sector. Base rates, discount steps, and floors.</p>
    </div>

    <div class="rounded-lg border border-white/10 bg-white/5 p-6">
      <div class="mb-4 flex items-center justify-between">
        <h2 class="text-xl font-semibold text-white">Pricing Tiers</h2>
        <button
          id="createTierBtn"
          type="button"
          class="rounded-lg bg-green-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-green-700"
        >
          + Create Tier
        </button>
      </div>

      {
        sectors.length === 0 ? (
          <div class="py-8 text-center">
            <p class="text-white/70">No sectors configured yet. Create sectors first.</p>
          </div>
        ) : (
          <div class="overflow-x-auto">
            <table class="w-full text-sm text-white">
              <thead class="border-b border-white/10 bg-white/10">
                <tr>
                  <th class="px-6 py-3 text-left font-semibold">Sector</th>
                  <th class="px-6 py-3 text-right font-semibold">Base Rate</th>
                  <th class="px-6 py-3 text-right font-semibold">Daily Floor</th>
                  <th class="px-6 py-3 text-center font-semibold">Discount Tiers</th>
                  <th class="px-6 py-3 text-right font-semibold">Status</th>
                  <th class="px-6 py-3 text-right font-semibold">Created</th>
                  <th class="px-6 py-3 text-right font-semibold">Actions</th>
                </tr>
              </thead>
              <tbody>
                {sectors.map((sector, index) => {
                  const activeTier = activeTiersBySetor.get(sector.id);
                  return (
                    <tr
                      key={sector.id}
                      class:list={`border-t border-white/10 ${
                        index % 2 === 0 ? "bg-white/0" : "bg-white/5"
                      }`}
                    >
                      <td class="px-6 py-4 font-medium text-white">{sector.name}</td>
                      <td class="px-6 py-4 text-right">{activeTier ? `$${activeTier.base_daily_rate ?? 0}` : "-"}</td>
                      <td class="px-6 py-4 text-right">{activeTier ? `$${activeTier.daily_floor ?? 0}` : "-"}</td>
                      <td class="px-6 py-4 text-center">
                        {activeTier && activeTier.discount_steps && Array.isArray(activeTier.discount_steps)
                          ? activeTier.discount_steps.length
                          : 0}
                      </td>
                      <td class="px-6 py-4 text-right">
                        {activeTier ? (
                          <span class="inline-flex items-center rounded-full bg-green-500/10 px-3 py-1 text-xs font-medium text-green-400">
                            Active
                          </span>
                        ) : (
                          <span class="inline-flex items-center rounded-full bg-yellow-500/10 px-3 py-1 text-xs font-medium text-yellow-400">
                            None
                          </span>
                        )}
                      </td>
                      <td class="px-6 py-4 text-right">{new Date(activeTier?.created_at || new Date()).toLocaleDateString()}</td>
                      <td class="px-6 py-4 text-right">
                        <button
                          class="editTierBtn text-blue-400 hover:text-blue-300"
                          data-sector-id={sector.id}
                          data-tier-id={activeTier?.id}
                        >
                          {activeTier ? "Edit" : "Create"}
                        </button>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        )
      }
    </div>

    <div id="tierFormContainer" class="hidden rounded-lg border border-white/10 bg-white/5 p-6">
      <h2 class="mb-4 text-xl font-semibold text-white" id="tierFormTitle">Create Pricing Tier</h2>
      <p class="mb-4 text-white/70" id="tierFormDescription">Configure base rate, floor, and discount steps.</p>

      <PricingTierForm
        client:load
        sectorId={sectors[0]?.id || ""}
        sectors={sectors}
        onCancel={() => {
          document.getElementById("tierFormContainer")?.classList.add("hidden");
        }}
      />
    </div>
  </div>

  <script>
    const createTierBtn = document.getElementById("createTierBtn");
    const tierFormContainer = document.getElementById("tierFormContainer");
    const editTierBtns = document.querySelectorAll(".editTierBtn");
    let selectedSectorId: string | null = null;

    function showTierForm(sectorId: string, isEdit: boolean = false) {
      const title = document.getElementById("tierFormTitle");
      const description = document.getElementById("tierFormDescription");

      if (title) title.textContent = isEdit ? "Edit Pricing Tier" : "Create Pricing Tier";
      if (description)
        description.textContent = isEdit
          ? "Update pricing configuration for this sector."
          : "Configure base rate, floor, and discount steps.";

      selectedSectorId = sectorId;
      tierFormContainer?.classList.remove("hidden");
      
      // Dispatch event to update the form's sectorId prop
      window.dispatchEvent(new CustomEvent("showPricingForm", { detail: { sectorId } }));
    }

    function closeTierForm() {
      tierFormContainer?.classList.add("hidden");
    }

    createTierBtn?.addEventListener("click", () => {
      const firstSectorId = Array.from(editTierBtns)[0]?.getAttribute("data-sector-id");
      if (firstSectorId) {
        showTierForm(firstSectorId, false);
      }
    });

    editTierBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const sectorId = (btn as HTMLElement).dataset.sectorId;
        const tierId = (btn as HTMLElement).dataset.tierId;
        if (sectorId) {
          showTierForm(sectorId, !!tierId);
          // Dispatch event with tier ID if editing
          if (tierId) {
            window.dispatchEvent(new CustomEvent("showPricingForm", { detail: { sectorId, tierId } }));
          } else {
            window.dispatchEvent(new CustomEvent("showPricingForm", { detail: { sectorId } }));
          }
        }
      });
    });

    // Listen for tierSaved event from PricingTierForm
    window.addEventListener("tierSaved", () => {
      closeTierForm();
      // Reload page to show new/updated tier
      window.location.reload();
    });

    // Listen for cancelPricingForm event from PricingTierForm
    window.addEventListener("cancelPricingForm", () => {
      closeTierForm();
    });
  </script>
</AdminLayout>
