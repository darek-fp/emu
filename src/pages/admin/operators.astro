/* eslint-disable @typescript-eslint/no-unsafe-assignment, @typescript-eslint/no-unsafe-member-access, @typescript-eslint/no-unsafe-return, @typescript-eslint/no-unsafe-argument, @typescript-eslint/no-unused-vars, no-console, @typescript-eslint/no-unnecessary-condition, @typescript-eslint/no-non-null-assertion, @typescript-eslint/prefer-nullish-coalescing */`n---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { OperatorForm } from "@/components/admin/OperatorForm";
import { OperatorSectorEditor } from "@/components/admin/OperatorSectorEditor";
import { createClient } from "@/lib/supabase";
import type { Database } from "@/database.types";

type Operator = Database["public"]["Tables"]["operators"]["Row"];
type OperatorWithEmail = Operator & { email?: string };
type Sector = Database["public"]["Tables"]["sectors"]["Row"];
type OperatorSectorAssignment = Database["public"]["Tables"]["operator_sector_assignments"]["Row"];

// Check authentication
const user = Astro.locals.user;
const role = Astro.locals.role;

if (!user || role !== "admin") {
  return Astro.redirect("/auth/signin");
}

// Fetch operators, sectors, and assignments
const supabase = createClient(Astro.request.headers, Astro.cookies);

let operators: OperatorWithEmail[] = [];
let sectors: Sector[] = [];
let assignments: OperatorSectorAssignment[] = [];
let error: string | null = null;

if (supabase) {
  // Fetch sectors
  const { data: sectorsData, error: sectorsError } = await supabase
    .from("sectors")
    .select("*")
    .order("created_at", { ascending: true });

  if (sectorsError) {
    error = `Failed to load sectors: ${sectorsError.message}`;
  } else {
    sectors = sectorsData ?? [];
  }

  // Fetch operators
  const { data: operatorsData, error: operatorsError } = await supabase
    .from("operators")
    .select("*")
    .order("created_at", { ascending: false });

  if (operatorsError) {
    error = `Failed to load operators: ${operatorsError.message}`;
  } else {
    operators = operatorsData ?? [];
  }

  // Fetch operator sector assignments
  const { data: assignmentsData, error: assignmentsError } = await supabase
    .from("operator_sector_assignments")
    .select("*")
    .order("assigned_at", { ascending: true });

  if (assignmentsError) {
    error = `Failed to load sector assignments: ${assignmentsError.message}`;
  } else {
    assignments = assignmentsData ?? [];
  }
}

// Map sector IDs to names for display
const sectorMap = new Map(sectors.map((s) => [s.id, s.name]));

// Group assignments by operator (for display - sector names)
const assignmentsByOperator = new Map<string, string[]>();
// Group assignments by operator (for edit - sector IDs)
const assignmentIdsByOperator = new Map<string, string[]>();
for (const assignment of assignments) {
  if (!assignmentsByOperator.has(assignment.operator_id)) {
    assignmentsByOperator.set(assignment.operator_id, []);
    assignmentIdsByOperator.set(assignment.operator_id, []);
  }
  const sectorName = sectorMap.get(assignment.sector_id);
  if (sectorName) {
    assignmentsByOperator.get(assignment.operator_id)!.push(sectorName);
  }
  assignmentIdsByOperator.get(assignment.operator_id)!.push(assignment.sector_id);
}

// Get active and deactivated operators
const activeOperators = operators.filter((op) => !op.deactivated_at);
const deactivatedOperators = operators.filter((op) => op.deactivated_at);
---

<AdminLayout title="Operator Management">
  <div class="space-y-8">
    {
      error && (
        <div class="rounded-lg border border-red-500/20 bg-red-500/10 p-4">
          <p class="text-red-400">{error}</p>
        </div>
      )
    }

    <div>
      <h1 class="mb-2 text-3xl font-bold text-white">Operator Management</h1>
      <p class="text-white/70">Manage operators and their assigned sectors.</p>
    </div>

    <div id="formContainer" class="hidden rounded-lg border border-white/10 bg-white/5 p-6">
      <h2 class="mb-4 text-xl font-semibold text-white" id="formTitle">Add New Operator</h2>
      <p class="mb-4 text-white/70" id="formDescription">Create a new operator and assign sectors.</p>

      <OperatorForm client:load sectors={sectors} />
    </div>

    <div id="editFormContainer" class="hidden rounded-lg border border-white/10 bg-white/5 p-6">
      <h2 class="mb-4 text-xl font-semibold text-white">Edit Operator Sectors</h2>

      <OperatorSectorEditor client:load sectors={sectors} />
    </div>

    <div class="rounded-lg border border-white/10 bg-white/5 p-6">
      <div class="mb-4 flex items-center justify-between">
        <h2 class="text-xl font-semibold text-white">Operators</h2>
        <button
          id="addNewBtn"
          type="button"
          class="rounded-lg bg-green-600 px-4 py-2 text-sm font-medium text-white shadow-lg transition-colors hover:bg-green-700"
          onclick="document.getElementById('formContainer').classList.remove('hidden'); document.getElementById('editFormContainer').classList.add('hidden'); document.getElementById('formContainer')?.scrollIntoView({ behavior: 'smooth', block: 'start' });"
        >
          + Add Operator
        </button>
      </div>
      {
        activeOperators.length === 0 ? (
          <div class="py-8 text-center">
            <p class="text-white/70">No operators configured yet.</p>
          </div>
        ) : (
          <div class="overflow-x-auto">
            <table class="w-full text-sm text-white">
              <thead class="border-b border-white/10 bg-white/10">
                <tr>
                  <th class="px-6 py-3 text-left font-semibold">Email</th>
                  <th class="px-6 py-3 text-left font-semibold">Assigned Sectors</th>
                  <th class="px-6 py-3 text-right font-semibold">Created</th>
                  <th class="px-6 py-3 text-right font-semibold">Actions</th>
                </tr>
              </thead>
              <tbody>
                {activeOperators.map((operator, index) => {
                  const operatorSectors = assignmentsByOperator.get(operator.id) ?? [];
                  return (
                    <tr
                      class:list={`border-t border-white/10 ${
                        index % 2 === 0 ? "bg-white/0" : "bg-white/5"
                      } transition-colors hover:bg-white/10`}
                    >
                      <td class="px-6 py-4">{operator.email || "—"}</td>
                      <td class="px-6 py-4">{operatorSectors.length > 0 ? operatorSectors.join(", ") : "—"}</td>
                      <td class="px-6 py-4 text-right text-white/60">
                        {new Date(operator.created_at).toLocaleDateString()}
                      </td>
                      <td class="px-6 py-4 text-right">
                        <div class="flex justify-end gap-2">
                          <button
                            class="editBtn rounded bg-blue-600 px-3 py-1 text-sm font-medium text-white transition-colors hover:bg-blue-700"
                            type="button"
                            data-operator-id={operator.id}
                            data-operator-email={operator.email}
                            data-operator-sectors={JSON.stringify(assignmentIdsByOperator.get(operator.id) ?? [])}
                            onclick={`
                              const btn = event.target;
                              const operatorId = btn.getAttribute('data-operator-id');
                              const operatorEmail = btn.getAttribute('data-operator-email');
                              const sectorStr = btn.getAttribute('data-operator-sectors');
                              const sectorIds = sectorStr ? JSON.parse(sectorStr) : [];
                               
                              document.getElementById('editFormContainer').classList.remove('hidden');
                              document.getElementById('formContainer').classList.add('hidden');
                              document.getElementById('editFormContainer')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
                               
                              window.dispatchEvent(new CustomEvent('editOperator', {
                                detail: {
                                  operatorId,
                                  email: operatorEmail,
                                  currentSectorIds: sectorIds
                                }
                              }));
                            `}
                          >
                            Edit
                          </button>
                          <button
                            class="deactivateBtn rounded bg-red-600 px-3 py-1 text-sm font-medium text-white transition-colors hover:bg-red-700"
                            data-operator-id={operator.id}
                          >
                            Deactivate
                          </button>
                        </div>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        )
      }
    </div>

    {
      deactivatedOperators.length > 0 && (
        <div class="rounded-lg border border-white/10 bg-white/5 p-6">
          <details>
            <summary class="cursor-pointer text-xl font-semibold text-white hover:text-white/80">
              Deactivated Operators ({deactivatedOperators.length})
            </summary>
            <div class="mt-4 overflow-x-auto">
              <table class="w-full text-sm text-white">
                <thead class="border-b border-white/10 bg-white/10">
                  <tr>
                    <th class="px-6 py-3 text-left font-semibold">Email</th>
                    <th class="px-6 py-3 text-left font-semibold">Assigned Sectors</th>
                    <th class="px-6 py-3 text-right font-semibold">Deactivated</th>
                  </tr>
                </thead>
                <tbody>
                  {deactivatedOperators.map((operator, index) => {
                    const operatorSectors = assignmentsByOperator.get(operator.id) ?? [];
                    return (
                      <tr
                        class:list={`border-t border-white/10 ${
                          index % 2 === 0 ? "bg-white/0" : "bg-white/5"
                        } transition-colors hover:bg-white/10`}
                      >
                        <td class="px-6 py-4">{operator.email || "—"}</td>
                        <td class="px-6 py-4">{operatorSectors.length > 0 ? operatorSectors.join(", ") : "—"}</td>
                        <td class="px-6 py-4 text-right text-white/60">
                          {operator.deactivated_at ? new Date(operator.deactivated_at).toLocaleDateString() : "—"}
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </details>
        </div>
      )
    }
  </div>

  <script>
    // Simple event listeners for form visibility
    window.addEventListener("operatorCreated", () => {
      document.getElementById("formContainer")?.classList.add("hidden");
      setTimeout(() => {
        window.location.reload();
      }, 500);
    });

    window.addEventListener("operatorUpdated", () => {
      document.getElementById("editFormContainer")?.classList.add("hidden");
      setTimeout(() => {
        window.location.reload();
      }, 500);
    });

    window.addEventListener("cancelForm", () => {
      document.getElementById("formContainer")?.classList.add("hidden");
    });

    window.addEventListener("cancelEditForm", () => {
      document.getElementById("editFormContainer")?.classList.add("hidden");
    });

    // Deactivate button handlers
    document.addEventListener("DOMContentLoaded", () => {
      const deactivateBtns = document.querySelectorAll(".deactivateBtn");
      deactivateBtns.forEach((btn) => {
        btn.addEventListener("click", async (e) => {
          const operatorId = (btn as HTMLElement).dataset.operatorId;
          if (!operatorId) return;

          if (!confirm("Are you sure you want to deactivate this operator?")) {
            return;
          }

          try {
            const response = await fetch(`/api/admin/operators/${operatorId}`, {
              method: "PATCH",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ action: "deactivate" }),
            });

            if (response.ok) {
              window.location.reload();
            } else {
              alert("Failed to deactivate operator");
            }
          } catch (err) {
            alert("Error deactivating operator");
          }
        });
      });
    });
  </script>
</AdminLayout>

